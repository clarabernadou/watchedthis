# Copy this file to ".env" in the backend folder and fill in the values.
# The real ".env" file is ignored by Git and must never be committed.

# Port of the API (the frontend calls http://localhost:8080)
PORT=8080

# TMDB API key (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Gmail account and application password used to send verification e-mails
GMAIL_EMAIL=
GMAIL_KEY=
